{
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "craftifix-app.vercel.app"
        }
      ],
      "destination": "https://www.craftifix.com/$1",
      "permanent": true
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "crochethub-tan.vercel.app"
        }
      ],
      "destination": "https://www.craftifix.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/signup",
      "destination": "/api/account?action=signup"
    },
    {
      "source": "/api/login",
      "destination": "/api/account?action=login"
    },
    {
      "source": "/api/forgot-password",
      "destination": "/api/account?action=forgot"
    },
    {
      "source": "/api/reset-password",
      "destination": "/api/account?action=reset"
    },
    {
      "source": "/api/logout",
      "destination": "/api/account?action=logout"
    },
    {
      "source": "/api/me",
      "destination": "/api/account?action=me"
    },
    {
      "source": "/api/plan",
      "destination": "/api/account?action=plan"
    },
    {
      "source": "/api/profile",
      "destination": "/api/account?action=profile"
    },
    {
      "source": "/api/rates",
      "destination": "/api/account?action=rates"
    },
    {
      "source": "/api/stripe/webhook",
      "destination": "/api/billing?action=webhook"
    },
    {
      "source": "/api/cron/reprice",
      "destination": "/api/billing?action=reprice"
    },
    {
      "source": "/s/:u/:p",
      "destination": "/api/shop?action=share&u=:u&p=:p"
    },
    {
      "source": "/s/:u",
      "destination": "/api/shop?action=share&u=:u"
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reprice",
      "schedule": "15 4 * * *"
    }
  ]
}
